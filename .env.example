# Copy this file to .env.local. Leave the selected provider's API key empty to use programmatic mock responses.
# 复制为 .env.local。所选服务商的 API Key 留空时走程序化演示数据（is_mock: true）。

AI_PROVIDER=auto
AI_PROVIDER_FALLBACK=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Auto mode uses DashScope for mainland China (CN) and OpenAI elsewhere.
# For local development or deployments without trusted geolocation headers, AI_PROVIDER_FALLBACK is used.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
